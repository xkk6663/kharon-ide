/*
 * ESP32-S3 板级 overlay（korvo_sys 用）
 *
 * 两件事：
 *   1) 控制台从 uart0（CP2102 那一路）切到芯片内置的 USB-Serial-JTAG——
 *      本板只插原生 USB 口，不切的话串口一片空白。
 *   2) 把 app.overlay 里那几段"打开 coretemp / wdt0"搬过来。
 *
 * 为什么第 2 步必须搬：Zephyr 的自动 overlay 是**二选一**，不是叠加——
 *   cmake/modules/configuration_files.cmake:75-89
 *     if(NOT DEFINED DTC_OVERLAY_FILE)
 *       zephyr_file(... ${APPLICATION_CONFIG_DIR}/socs ...)      # socs/<soc>.overlay
 *       zephyr_file(... ${APPLICATION_CONFIG_DIR}/boards ...)    # boards/<board>.overlay  ← 先命中
 *     endif()
 *     if(NOT DEFINED DTC_OVERLAY_FILE) ... NAMES "app.overlay"   # 只有前面都没命中才兜底
 * 也就是说：一旦 app 目录下有 boards/<board>.overlay，app.overlay 就**完全不会被用**。
 * 在 S3 上就表现为：本文件把 console 切好了，但 app.overlay 里那句
 *   &coretemp { status = "okay"; }
 * 没生效 → 节点仍是 disabled → 驱动不实例化 → DEVICE_DT_GET 的 __device_dts_ord_48 未定义。
 */

&usb_serial {
	status = "okay";
};

/* 片上温度传感器：S3 dtsi 里是 compatible = "espressif,esp32-temp"，默认 disabled */
&coretemp {
	status = "okay";
};

/* 看门狗：S3 dtsi 里 wdt0 默认 disabled，打开后 WDT_ESP32 驱动才会被选中 */
&wdt0 {
	status = "okay";
};

/ {
	chosen {
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		/* S3 的 dtsi 已经写好 zephyr,entropy = &trng0，这里再写一遍只是让本文件自解释 */
		zephyr,entropy = &trng0;
	};
};
