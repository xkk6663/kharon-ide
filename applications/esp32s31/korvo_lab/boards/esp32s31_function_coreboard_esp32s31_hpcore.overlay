/*
 * korvo_lab 的 Korvo-1（ESP32-S31）板级 overlay（驱动实验台）
 *
 * 文件名 = 板目标下划线化：esp32s31_function_coreboard/esp32s31/hpcore
 *          -> esp32s31_function_coreboard_esp32s31_hpcore.overlay
 *
 * 公共差异收进 ../../../common/korvo_board.dtsi（PA_CTRL / WS2812@GPIO37 / adc0），
 * 本工程额外要 I2C0，所以再引一层 ../../../common/korvo_i2c.dtsi。
 * 相对路径是相对本文件（boards\），所以是 ..\..\..\common\。
 *
 * 引脚（官方用户指南 V1.1）：
 *   I2C_SDA=GPIO0  I2C_SCL=GPIO1（ES8389）
 *   PA_CTRL=GPIO7  WS2812=GPIO37（RMT OUT0）
 *   BOOT=GPIO61（bank1 pin29，上游板级 gpio-keys 里已定义）
 */

#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

#include "../../../common/korvo_board.dtsi"
#include "../../../common/korvo_i2c.dtsi"

/* ---------- 第 3 项：PWM（LEDC0 通道 0 → GPIO26） ----------
 * 板上没有独立的 PWM 负载（LCD_MOSI/SCK 是屏专用），GPIO26 在官方管脚表里
 * 未被任何器件占用，接一个 LED + 限流电阻就能看到呼吸效果。
 * LEDC 的通道必须在子节点里声明（reg = 通道号），pinctrl 宏名是 LEDC_CH0_GPIO26。
 */
&pinctrl {
	ledc0_korvo: ledc0_korvo {
		group1 {
			pinmux = <LEDC_CH0_GPIO26>;
			output-enable;
		};
	};
};

&ledc0 {
	pinctrl-0 = <&ledc0_korvo>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0>;
		timer = <0>;
	};
};

/ {
	pwmleds {
		compatible = "pwm-leds";

		breath: breath_led {
			/* 通道 0，周期 1 ms（1 kHz），高有效 */
			pwms = <&ledc0 0 1000000 GPIO_ACTIVE_HIGH>;
			label = "BREATH";
		};
	};

	aliases {
		pwm-led0 = &breath;
		can0 = &twai0;
	};
};
