/*
 * korvo_apps 的 Korvo-1（ESP32-S31）板级 overlay
 *
 * 文件名 = 板目标用下划线连起来：
 *   esp32s31_function_coreboard/esp32s31/hpcore
 *   -> esp32s31_function_coreboard_esp32s31_hpcore.overlay
 * Zephyr 按 -b 的板名自动挑这一层，命令行不用再 -DDTC_OVERLAY_FILE。
 * （同目录下还有 esp32s3_devkitc_esp32s3_procpu.overlay：两块板各一份，互不干扰）
 *
 * 公共差异（PA_CTRL / WS2812@GPIO37 / adc0）已经收进 ../../../common/korvo_board.dtsi，
 * 注意这里的相对路径是相对"本文件所在目录"（boards\），所以比 app.overlay 时期多一层 ..\
 *
 * 这里只留本工程独有的部分：
 *   - adc1：四个功能键的电压窗口实测要两个 ADC 单元都扫一遍才能确定落在哪个通道
 *
 * 业务层（动画引擎 / 帧率 / NVS 记忆）不碰寄存器、不碰时序，只认 dts 别名。
 */

#include "../../../common/korvo_board.dtsi"

/* 两个 ADC 单元都打开，用来找出 IO42 上 4 个功能键落在哪个通道 */
&adc1 {
	status = "okay";
};
