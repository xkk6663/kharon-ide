/*
 * korvo_periph 的 Korvo-1（ESP32-S31）板级 overlay
 *
 * 文件名 = 板目标用下划线连起来：
 *   esp32s31_function_coreboard/esp32s31/hpcore
 *   -> esp32s31_function_coreboard_esp32s31_hpcore.overlay
 *
 * 公共差异（PA_CTRL / WS2812@GPIO37 / adc0）在 ../../../common/korvo_board.dtsi，
 * I2C0 接线（SDA=IO0 / SCL=IO1）在 ../../../common/korvo_i2c.dtsi。
 * 相对路径是相对"本文件所在目录"（boards\），所以退两级。
 *
 * 本工程独有、且只属于应用层演示的三处：
 *   1. LEDC0 的 PWM 输出脚（板上没有独立 LED，借 LCD 子板的 VSYNC 脚 IO44）
 *   2. twai0 明确 okay（上游板级已 okay，这里写一遍是为了"这份工程自证"）
 *   3. IO42 → ADC1_CH0 的通道号（S31 是"每个模拟 pad 一个通道"，见
 *      hal\espressif\components\soc\esp32s31\include\soc\adc_channel.h）
 */

#include "../../../common/korvo_board.dtsi"
#include "../../../common/korvo_i2c.dtsi"

/* ---- ③ PWM：LEDC 低功耗通道 0 -> IO44 ---- */
&pinctrl {
	ledc0_demo: ledc0_demo {
		group1 {
			pinmux = <LEDC_CH0_GPIO44>;
		};
	};
};

&ledc0 {
	status = "okay";
	pinctrl-0 = <&ledc0_demo>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	/*
	 * LEDC 驱动不是"给个通道号就能用"：它按子节点建通道表
	 * （pwm_led_esp32.c 的 get_channel_config() 会在表里找 idx）。
	 * 漏掉这个子节点时的报错是：
	 *   <err> pwm_ledc_esp32: Error getting channel 0
	 * 这里的 reg 必须和 pinctrl 里的 LEDC_CHn 对上，timer 决定用哪个定时器。
	 */
	channel0@0 {
		reg = <0>;
		timer = <0>;
	};
};

/* ---- ⑥ CAN：内部回环自测，引脚沿用上游板级（TX=IO14 / RX=IO13） ---- */
&twai0 {
	status = "okay";
};

/*
 * ---- ① ADC：修正 S31 SoC dtsi 的 unit 编号错位 ----
 *
 * 现象：korvo keys 里 IO42 恒为 0，四键怎么按都不动（2026-11-14 实测）。
 *
 * 证据链：
 *   hal\esp32s31\...\adc_types.h:22   typedef enum { ADC_UNIT_1, ADC_UNIT_2 }  -> 0 基
 *   esp32s31\adc_periph.c:10          adc_channel_io_map[0]=ADC1(IO42..49) / [1]=ADC2(IO50..57)
 *   esp32s31_common.dtsi:456           adc0 { unit = <1> }   <- 一基，错了
 *   drivers\adc\adc_esp32.c:334        io_map[conf->unit][ch]  与 :398 .unit = conf->unit
 *
 * 于是 adc0 被当成 ADC2：采的是 IO50..57，配 pad 也配 IO50..57，
 * IO42（ADC1_CH0）从头到尾没进过采样与 pad 配置 -> 恒 0。
 *
 * 在板级层改回来（自己板子的 overlay，不算改上游）：
 */
&adc0 {
	unit = <0>;
};

&adc1 {
	unit = <1>;
};

